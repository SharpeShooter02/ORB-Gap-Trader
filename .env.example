# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ── Alpaca credentials ────────────────────────────────────────────────────────
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Set to false ONLY after full paper-trading validation
ALPACA_PAPER=true

# ── Alert webhook (Discord / Telegram / Slack) ────────────────────────────────
# Leave blank to disable alerts
ALERT_WEBHOOK_URL=
ALERT_LEVEL=WARN              # INFO | WARN | CRITICAL
ALERT_INFO_OPT_IN=false

# ── Backup storage (Backblaze B2 / Cloudflare R2 / AWS S3) ───────────────────
# Leave blank to disable nightly backup
BACKUP_BUCKET_URL=            # e.g. b2://my-bucket/orb-live/
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=

# ── Health server ─────────────────────────────────────────────────────────────
HEALTH_PORT=8080

# ── Cloudflare R2 endpoint (only needed if using R2) ─────────────────────────
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
