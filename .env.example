# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ── Interactive Brokers ───────────────────────────────────────────────────────
# IB Gateway must be running. Set IB_LIVE=1 ONLY after paper-trading validation.
# IB_LIVE=1

# ── Alert webhook (Discord / Telegram / Slack) ────────────────────────────────
# Leave blank to disable alerts
ALERT_WEBHOOK_URL=
ALERT_LEVEL=WARN              # INFO | WARN | CRITICAL
ALERT_INFO_OPT_IN=false

# ── Backup storage (Backblaze B2 / Cloudflare R2 / AWS S3) ───────────────────
# Leave blank to disable nightly backup
BACKUP_BUCKET_URL=            # e.g. b2://my-bucket/orb-live/
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=

# ── Sigma recalibration ───────────────────────────────────────────────────────
# Set to 0 to force frozen SIGMA seeds (skip runtime recalibration).
# Default behaviour recomputes sigmas from full historical data at startup
# and weekly via cron.
# USE_ROLLING_SIGMAS=1

# ── Health server ─────────────────────────────────────────────────────────────
HEALTH_PORT=8080

# ── Cloudflare R2 endpoint (only needed if using R2) ─────────────────────────
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
